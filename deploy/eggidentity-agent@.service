[Unit]
Description=EggIdentity deploy agent (%i)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=eggidentity-agent
Group=eggidentity-agent
EnvironmentFile=/etc/eggidentity/%i.env
WorkingDirectory=/opt/eggidentity-agent/publish
ExecStart=/usr/bin/dotnet /opt/eggidentity-agent/publish/EggIdentity.Agent.dll
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
