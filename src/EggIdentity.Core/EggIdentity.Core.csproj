<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>EggIdentity's own dogfood host: runs EggIdentity's Discord bot and its /admin config page.</Description>
    <RootNamespace>EggIdentity.Core</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggIdentity.Contract\EggIdentity.Contract.csproj" />
    <ProjectReference Include="..\EggIdentity.Db\EggIdentity.Db.csproj" />
    <ProjectReference Include="..\EggIdentity.Config\EggIdentity.Config.csproj" />
    <ProjectReference Include="..\EggIdentity.Auth\EggIdentity.Auth.csproj" />
    <ProjectReference Include="..\EggIdentity.Client\EggIdentity.Client.csproj" />
    <ProjectReference Include="..\EggIdentity.Bot\EggIdentity.Bot.csproj" />
    <ProjectReference Include="..\EggIdentity.Bot.AdminUi\EggIdentity.Bot.AdminUi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\EggIdentity.Bot\Migrations\*.up.sql" Link="Migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
